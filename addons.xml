<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.bender2403" name="Bender2403 Add-on Repository" version="1.0.3" provider-name="Bender2403">
  <requires>
    <import addon="xbmc.addon" version="12.0.0" />
  </requires>
  <extension point="xbmc.addon.repository" name="Bender2403 Add-on Repository">
    <dir>
      <info>https://raw.githubusercontent.com/Bender2403/repository.bender2403/main/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/Bender2403/repository.bender2403/main/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/Bender2403/repository.bender2403/main</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="de_DE">Offizielles Kodi-Add-on-Repository von Bender2403</summary>
    <description lang="de_DE">Stellt geprüfte Kodi-Add-ons und deren Aktualisierungen bereit.</description>
    <news>v1.0.3
- Versionsnummer erhöht, damit bestehende Installationen das Repository-Add-on aktualisieren können.</news>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="program.optiklean" name="OptiKlean" provider-name="DigiTalking" version="2.4.0">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>executable</provides>
    </extension>
	<extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <license>MIT</license>
        <source>https://gitlab.com/personal4143605/optiklean</source>
        <summary lang="en_GB">Clean and optimize Kodi utility.</summary>
        <summary lang="it_IT">Utilità di pulizia e ottimizzazione Kodi.</summary>
        <summary lang="de_DE">Hilfsprogramm zur Bereinigung und Optimierung von Kodi.</summary>
        <description lang="en_GB">Advanced tool to perform various types of Kodi cleaning and optimization.</description>
        <description lang="it_IT">Strumento avanzato che permette di eseguire vari tipi di pulizie e ottimizzazione Kodi.</description>
        <description lang="de_DE">Erweitertes Werkzeug zur Durchführung verschiedener Arten der Kodi-Bereinigung und -Optimierung.</description>
        <assets>
            <icon>resources/media/icon.jpg</icon>
            <fanart>resources/media/fanart.jpg</fanart>
            <screenshot>resources/media/screenshot-1.png</screenshot>
            <screenshot>resources/media/screenshot-2.png</screenshot>
            <screenshot>resources/media/screenshot-3.png</screenshot>
        </assets>
    </extension>
</addon>
<addon id="script.eternity.sicherung" name="Eternity Code-Sicherung" version="1.0.9" provider-name="lokal">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="script.module.requests" version="2.0.0" optional="true" />
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="de_DE">Code-Paket sichern, entpacken und fertige Kodi-ZIP erstellen</summary>
    <description lang="de_DE">Lädt das Eternity-Code-Paket herunter, speichert es als bundle.bin, entpackt alle Python-Dateien im eigenen addon_data-Ordner und erstellt daraus eine installierbare Kodi-ZIP. Enthält requests- und urllib-Download, optionalen Fallback sowie Diagnose.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
</addons>
