msgctxt "#32000"
msgid "Allgemein"
msgstr "Allgemein"

msgctxt "#32001"
msgid "GitHub-Upload"
msgstr "GitHub-Upload"

msgctxt "#32002"
msgid "Upload-Ziel"
msgstr "Upload-Ziel"

msgctxt "#32003"
msgid "GitHub (Standard)"
msgstr "GitHub (Standard)"

msgctxt "#32004"
msgid "paste.kodi.tv"
msgstr "paste.kodi.tv"

msgctxt "#32005"
msgid "GitHub-Repository"
msgstr "GitHub-Repository"

msgctxt "#32006"
msgid "GitHub-Branch"
msgstr "GitHub-Branch"

msgctxt "#32007"
msgid "GitHub Fine-grained Token"
msgstr "GitHub Fine-grained Token"

msgctxt "#32008"
msgid "Experte"
msgstr "Experte"

msgctxt "#32010"
msgid "Authentifizierung"
msgstr "Authentifizierung"

msgctxt "#32011"
msgid "Upload Kodi log normally"
msgstr "Kodi-Log normal hochladen"

msgctxt "#32012"
msgid "Start diagnostics (Kodi-wide debug logging)"
msgstr "Diagnosemodus starten (Kodi-weites Debug-Logging)"

msgctxt "#32013"
msgid "Create and upload diagnostic package"
msgstr "Diagnosepaket erstellen und hochladen"

msgctxt "#32014"
msgid "Restore debug settings"
msgstr "Debug-Einstellungen wiederherstellen"

msgctxt "#32015"
msgid "Kodi Diag"
msgstr "Kodi Diag"

msgctxt "#32016"
msgid "Enable Kodi-wide debug logging?"
msgstr "Kodi-weites Debug-Logging aktivieren?"

msgctxt "#32017"
msgid "During diagnostics, more technical details and stream addresses may appear in the local Kodi log. Known credentials and URL parameters are sanitized before upload."
msgstr "Während der Diagnose können mehr technische Details und Stream-Adressen im lokalen Kodi-Log erscheinen. Vor dem Upload werden bekannte Zugangsdaten und URL-Parameter bereinigt."

msgctxt "#32018"
msgid "A diagnostic session is already active. After reproducing the issue, create the diagnostic package or restore the settings."
msgstr "Eine Diagnose ist bereits aktiv. Nach der Fehler-Reproduktion bitte das Diagnosepaket erstellen oder die Einstellungen wiederherstellen."

msgctxt "#32019"
msgid "Diagnostic mode is active."
msgstr "Diagnosemodus ist aktiv."

msgctxt "#32020"
msgid "Reproduce the issue now. Then start this add-on again and choose the diagnostic package option."
msgstr "Reproduziere jetzt den Fehler. Danach dieses Add-on erneut starten und „Diagnosepaket erstellen und hochladen“ wählen."

msgctxt "#32022"
msgid "Upload successful."
msgstr "Upload erfolgreich."

msgctxt "#32023"
msgid "The original Kodi logging settings have been restored."
msgstr "Die ursprünglichen Kodi-Logging-Einstellungen wurden wiederhergestellt."

msgctxt "#32024"
msgid "Diagnostic package uploaded."
msgstr "Diagnosepaket hochgeladen."

msgctxt "#32025"
msgid "The original Kodi logging settings have been restored."
msgstr "Ursprüngliche Kodi-Logging-Einstellungen wurden wiederhergestellt."

msgctxt "#32026"
msgid "There is no active diagnostic session."
msgstr "Es ist keine aktive Diagnose gespeichert."

msgctxt "#32027"
msgid "Operation failed: {error}"
msgstr "Vorgang fehlgeschlagen: {error}"

msgctxt "#32028"
msgid "kodi.log was not found, is empty or exceeds 64 MiB."
msgstr "kodi.log wurde nicht gefunden, ist leer oder größer als 64 MiB."

msgctxt "#32029"
msgid "Kodi does not expose the global debug switch."
msgstr "Kodi stellt den globalen Debug-Schalter nicht bereit."

msgctxt "#32030"
msgid "Kodi JSON-RPC error"
msgstr "Kodi-JSON-RPC-Fehler"

msgctxt "#32031"
msgid "GitHub token is missing. Enter it in the add-on settings."
msgstr "GitHub-Token fehlt. Bitte in den Add-on-Einstellungen eintragen."

msgctxt "#32032"
msgid "Invalid repository name. Expected owner/repository."
msgstr "Ungültiger Repository-Name. Erwartet wird owner/repository."


msgctxt "#32034"
msgid "Select add-ons to prioritize in logs"
msgstr "Add-ons auswählen, deren Logeinträge bevorzugt werden"

msgctxt "#32035"
msgid "Select installed add-ons whose log messages are important."
msgstr "Wähle installierte Add-ons aus, deren Logeinträge wichtig sind."

msgctxt "#32036"
msgid "Selection saved. {count} add-ons will be prioritized in diagnostic logs."
msgstr "Auswahl gespeichert. {count} Add-ons werden in Diagnoselogs bevorzugt."

msgctxt "#32037"
msgid "Kodi did not return any installed add-ons."
msgstr "Kodi hat keine installierten Add-ons zurückgegeben."

msgctxt "#32038"
msgid "Add-on diagnostics"
msgstr "Add-on-Diagnose"

msgctxt "#32039"
msgid "Enable this add-on's debug logging"
msgstr "Debug-Protokollierung dieses Add-ons aktivieren"

msgctxt "#32033"
msgid "GitHub upload failed (HTTP {status}): {detail}"
msgstr "GitHub-Upload fehlgeschlagen (HTTP {status}): {detail}"


msgctxt "#32040"
msgid "Protokollierung"
msgstr "Protokollierung"

msgctxt "#32041"
msgid "HTTP-/HTTPS-Protokollierung aktivieren"
msgstr "HTTP-/HTTPS-Protokollierung aktivieren"

msgctxt "#32042"
msgid "Erfasst zusätzliche cURL-Protokollzeilen mit HTTP-Statuscodes sowie ein- und ausgehenden Headern. Header und URLs können sensible Angaben enthalten; bekannte Zugangsdaten werden vor dem Upload bereinigt."
msgstr "Erfasst zusätzliche cURL-Protokollzeilen mit HTTP-Statuscodes sowie ein- und ausgehenden Headern. Header und URLs können sensible Angaben enthalten; bekannte Zugangsdaten werden vor dem Upload bereinigt."

msgctxt "#32043"
msgid "DRM-Protokollierung aktivieren"
msgstr "DRM-Protokollierung aktivieren"

msgctxt "#32044"
msgid "Erfasst Debug-Meldungen von InputStream Adaptive, darunter Widevine-Sitzungs- und Lizenzereignisse. Es werden keine rohen Lizenz-Challenges oder Lizenzantworten gesammelt."
msgstr "Erfasst Debug-Meldungen von InputStream Adaptive, darunter Widevine-Sitzungs- und Lizenzereignisse. Es werden keine rohen Lizenz-Challenges oder Lizenzantworten gesammelt."


msgctxt "#32045"
msgid "Automatische Diagnose"
msgstr "Automatische Diagnose"

msgctxt "#32046"
msgid "Diagnosemodus bei Video-/Stream-Wiedergabe"
msgstr "Diagnosemodus bei Video-/Stream-Wiedergabe"

msgctxt "#32047"
msgid "Erfasst Video- und Stream-Wiedergaben automatisch getrennt. Musik wird ignoriert. Beim Ausschalten wird sofort ein Diagnosepaket erstellt und vor dem Upload nachgefragt."
msgstr "Erfasst Video- und Stream-Wiedergaben automatisch getrennt. Musik wird ignoriert. Beim Ausschalten wird sofort ein Diagnosepaket erstellt und vor dem Upload nachgefragt."

msgctxt "#32048"
msgid "Diagnosepaket wurde erstellt. Möchtest du es jetzt hochladen?"
msgstr "Diagnosepaket wurde erstellt. Möchtest du es jetzt hochladen?"

msgctxt "#32049"
msgid "Diagnosepaket und temporäre Dateien wurden gelöscht."
msgstr "Diagnosepaket und temporäre Dateien wurden gelöscht."

msgctxt "#32050"
msgid "Upload fehlgeschlagen."
msgstr "Upload fehlgeschlagen."

msgctxt "#32051"
msgid "Upload fehlgeschlagen. Soll das Diagnosepaket gelöscht werden? Wenn du Nein wählst, bleibt es zum späteren Versuch erhalten."
msgstr "Upload fehlgeschlagen. Soll das Diagnosepaket gelöscht werden? Wenn du Nein wählst, bleibt es zum späteren Versuch erhalten."

msgctxt "#32052"
msgid "Diagnosepaket bleibt für einen späteren Upload gespeichert."
msgstr "Diagnosepaket bleibt für einen späteren Upload gespeichert."

msgctxt "#32053"
msgid "Diagnosepaket konnte nicht erstellt werden. Die Diagnose-Dateien bleiben erhalten."
msgstr "Diagnosepaket konnte nicht erstellt werden. Die Diagnose-Dateien bleiben erhalten."


msgctxt "#32054"
msgid "Gespeichertes Diagnosepaket erneut hochladen"
msgstr "Gespeichertes Diagnosepaket erneut hochladen"

msgctxt "#32055"
msgid "Es ist kein gespeichertes Diagnosepaket vorhanden."
msgstr "Es ist kein gespeichertes Diagnosepaket vorhanden."

msgctxt "#32056"
msgid "Gespeichertes Diagnosepaket jetzt erneut hochladen?"
msgstr "Gespeichertes Diagnosepaket jetzt erneut hochladen?"

msgctxt "#32057"
msgid "Select test log files from Kodi temp folder"
msgstr "Test-Logdateien aus dem Kodi-Temp-Ordner auswählen"

msgctxt "#32058"
msgid "Test mode"
msgstr "Testmodus"

msgctxt "#32059"
msgid "Enable test mode for log files"
msgstr "Testmodus für Logdateien aktivieren"

msgctxt "#32060"
msgid "When enabled, selected .log files in Kodi's temp folder replace the normal Kodi logs for processing. Up to six files of 64 MiB each are supported. Original files are not modified."
msgstr "Wenn aktiviert, ersetzen ausgewählte .log-Dateien im Kodi-Temp-Ordner die normalen Kodi-Logs bei der Verarbeitung. Unterstützt werden bis zu sechs Dateien mit jeweils maximal 64 MiB. Die Originaldateien werden nicht verändert."

msgctxt "#32061"
msgid "No valid .log files were selected from Kodi's temp folder. Files must exist and be no larger than 64 MiB."
msgstr "Es wurden keine gültigen .log-Dateien aus dem Kodi-Temp-Ordner ausgewählt. Die Dateien müssen vorhanden und höchstens 64 MiB groß sein."

msgctxt "#32062"
msgid "{count} test log files selected. They will be processed instead of the normal Kodi logs."
msgstr "{count} Test-Logdateien ausgewählt. Sie werden statt der normalen Kodi-Logs verarbeitet."

