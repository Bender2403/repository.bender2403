<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
  <section id="script.kodi.loguploader.github">
    <category id="general" label="30000">
      <group id="github" label="30001">
        <setting id="upload_target" type="string" label="30002">
          <default>github</default>
          <constraints>
            <options>
              <option label="30003">github</option>
              <option label="30004">paste</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>30002</heading>
          </control>
        </setting>
        <setting id="github_repo" type="string" label="30005">
          <default>Bender2403/kodi-rakuten-tv-addon</default>
          <control type="edit" format="string">
            <heading>30005</heading>
          </control>
        </setting>
        <setting id="github_branch" type="string" label="30006">
          <default>kodi-logs</default>
          <control type="edit" format="string">
            <heading>30006</heading>
          </control>
        </setting>
      </group>
    </category>
    <category id="expert" label="30008">
      <group id="authentication" label="30010">
        <setting id="github_token" type="string" label="30007">
          <level>3</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30007</heading>
            <hidden>true</hidden>
          </control>
        </setting>
      </group>
    </category>
  </section>
</settings>
