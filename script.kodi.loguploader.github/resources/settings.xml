<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
  <section id="script.kodi.loguploader.github">
    <category id="general" label="32000">
      <group id="github" label="32001">
        <setting id="upload_target" type="string" label="32002">
          <default>github</default>
          <constraints>
            <options>
              <option label="32003">github</option>
              <option label="32004">paste</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>32002</heading>
          </control>
        </setting>
        <setting id="github_repo" type="string" label="32005">
          <default>Bender2403/kodi-rakuten-tv-addon</default>
          <control type="edit" format="string">
            <heading>32005</heading>
          </control>
        </setting>
        <setting id="github_branch" type="string" label="32006">
          <default>kodi-logs</default>
          <control type="edit" format="string">
            <heading>32006</heading>
          </control>
        </setting>
      </group>
      <group id="diagnostics" label="32038">
        <setting id="debug_logging" type="boolean" label="32039">
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
      <group id="protocol_logging" label="32040">
        <setting id="http_logging" type="boolean" label="32041">
          <default>false</default>
          <help>32042</help>
          <control type="toggle"/>
        </setting>
        <setting id="drm_logging" type="boolean" label="32043">
          <default>false</default>
          <help>32044</help>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
    <category id="expert" label="32008">
      <group id="authentication" label="32010">
        <setting id="github_token" type="string" label="32007">
          <level>3</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>32007</heading>
            <hidden>true</hidden>
          </control>
        </setting>
      </group>
    </category>
  </section>
</settings>
